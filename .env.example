# Copie valores para as variáveis do processo. Django não carrega .env automaticamente.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_SECRET_KEY: obrigatório para produção; nunca versionar um valor real.
# Desenvolvimento usa SQLite em .local/db.sqlite3.
# PostgreSQL será necessário antes de reservas/consumo concorrentes.
# POSTGRES_DB=davigurumi
# POSTGRES_USER=davigurumi
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD: fornecer de forma segura, sem versionar.
# POSTGRES_SSLMODE=require
