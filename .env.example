# O aplicativo lê variáveis do processo; não carrega .env automaticamente.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Produção: defina segredo próprio fora do Git, DJANGO_DEBUG=0 e hosts explícitos.
# DJANGO_SECRET_KEY=
# PostgreSQL externo exige TLS; omitir POSTGRES_DB usa SQLite local.
# POSTGRES_DB=davigurumi
# POSTGRES_USER=davigurumi
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require
# DJANGO_MEDIA_ROOT=/caminho/privado
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Envio real: django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=

# Cadastro público: aberto no desenvolvimento, fechado por padrão em produção.
# DJANGO_PUBLIC_SIGNUP=0
# HSTS inicial somente em produção; subdomínios/preload dependem do domínio escolhido.
# DJANGO_HSTS_SECONDS=3600
# Produção proíbe o console de e-mail. Sem configuração, o backend não envia.

# Exclusão: configurar explicitamente um registro externo independente de backups.
# Runtime: montagem somente leitura; procedimento administrativo: escrita restrita.
# DJANGO_PRIVACY_LEDGER_DIR=/diretorio-privado-independente/exclusoes
# DJANGO_PRIVACY_LEDGER_KEY=segredo-proprio-diferente-da-chave-django
